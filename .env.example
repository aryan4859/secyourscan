# Copy-by-script: `python scripts/gen_secrets.py` fills the secrets below into .env.
# Connection URLs for the Compose services are set in docker-compose.yml.

ENV=production
# Set COOKIE_SECURE=true once served over HTTPS.
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:8080
ALLOWED_HOSTS=*
REQUIRE_DOMAIN_VERIFICATION=true  # scans cover only DNS-verified root domains; false only for labs

# ── Secrets (generated) ──
POSTGRES_PASSWORD=
RABBITMQ_PASS=
ES_PASSWORD=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# First admin, created on an empty database only.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── AI (optional): any OpenAI-compatible server you run ──
# Host LM Studio: http://host.docker.internal:1234/v1   Compose Ollama: http://ollama:11434/v1
AI_ENDPOINT=
AI_MODEL=llama3.1:8b

# ── Integrations (optional) ──
SOAR_WEBHOOK_URL=
THREATFOX_AUTH_KEY=
GITHUB_TOKEN=
HIBP_API_KEY=
OTX_API_KEY=                   # free at otx.alienvault.com; adds OTX passive DNS to Attack Surface

# ── Scoring ──
CRITICAL_THRESHOLD=80
SOAR_THRESHOLD=90
NEAR_DUP_THRESHOLD=3
